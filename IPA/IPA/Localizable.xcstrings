    "Apple will see a new device. Every account signs out and has to sign in again." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple vai ver um aparelho novo. Todas as contas saem e precisam entrar de novo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple verá un dispositivo nuevo. Todas las cuentas cerrarán sesión y tendrán que volver a entrar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple sieht ein neues Gerät. Alle Accounts werden abgemeldet und müssen sich neu anmelden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple verra un nouvel appareil. Tous les comptes sont déconnectés et doivent se reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple vedrà un nuovo dispositivo. Tutti gli account escono e devono accedere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleからは新しいデバイスに見えます。すべてのアカウントがサインアウトされ、再サインインが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple에는 새 기기로 보입니다. 모든 계정이 로그아웃되며 다시 로그인해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 会把它当成一台新设备。所有账户都会退出，需要重新登录。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple увидит новое устройство. Все учетные записи выйдут, и войти придется снова."
          }
        }
      }
    },
