    "Accounts and Settings keep the choices that are yours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts und Einstellungen bewahren deine Entscheidungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuentas y Ajustes guardan las opciones que son tuyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptes et Réglages gardent les choix qui vous appartiennent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account e Impostazioni conservano le scelte che sono tue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アカウント」と「設定」には、あなたの選択が保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정과 설정에는 나만의 선택이 담깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contas e Ajustes guardam as escolhas que são suas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «Аккаунтах» и «Настройках» хранятся ваши решения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“账户”和“设置”保存属于你的选择。"
          }
        }
      }
    },
    "Accounts stay in this device's Keychain and packages in the Files app. IPA has no servers of its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts bleiben im Schlüsselbund dieses Geräts und Pakete in der Dateien-App. IPA hat keine eigenen Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas se guardan en el llavero de este dispositivo y los paquetes en la app Archivos. IPA no tiene servidores propios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes restent dans le trousseau de cet appareil et les paquets dans l’app Fichiers. IPA n’a aucun serveur à lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli account restano nel portachiavi di questo dispositivo e i pacchetti nell’app File. IPA non ha server propri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントはこのデバイスのキーチェーンに、パッケージは「ファイル」Appに保存されます。IPAは独自のサーバを持ちません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정은 이 기기의 키체인에, 패키지는 파일 앱에 보관됩니다. IPA에는 자체 서버가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas ficam no Keychain deste aparelho e os pacotes no app Arquivos. O IPA não tem servidores próprios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунты хранятся в связке ключей этого устройства, а пакеты — в приложении «Файлы». У IPA нет своих серверов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账户保存在本设备的钥匙串中，安装包保存在“文件”App 中。IPA 没有自己的服务器。"
          }
        }
      }
    },
