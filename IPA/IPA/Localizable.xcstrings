    "The App Store sends up to 200 results per search. Fewer results load faster on a slow connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App Store liefert bis zu 200 Ergebnisse pro Suche. Weniger Ergebnisse laden bei langsamer Verbindung schneller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La App Store envía hasta 200 resultados por búsqueda. Menos resultados cargan más rápido con una conexión lenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'App Store envoie jusqu'à 200 résultats par recherche. Moins de résultats se chargent plus vite sur une connexion lente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'App Store invia fino a 200 risultati per ricerca. Meno risultati si caricano più in fretta con una connessione lenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeは1回の検索で最大200件を返します。回線が遅いときは件数が少ないほど速く読み込めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store는 검색당 최대 200개의 결과를 보냅니다. 연결이 느리면 결과가 적을수록 빨리 로드됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store envia até 200 resultados por busca. Menos resultados carregam mais rápido numa conexão lenta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store отдает до 200 результатов за поиск. При медленном соединении меньшее число загружается быстрее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 每次搜索最多返回 200 个结果。网络较慢时，结果越少加载越快。"
          }
        }
      }
    },
    "The accent color appears on buttons, tabs, selections and charts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Akzentfarbe erscheint auf Tasten, Tabs, Auswahlen und Diagrammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color de acento aparece en botones, pestañas, selecciones y gráficos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La couleur d’accent apparaît sur les boutons, onglets, sélections et graphiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colore di risalto compare su pulsanti, schede, selezioni e grafici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセントカラーはボタン、タブ、選択項目、グラフに使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강조 색상은 버튼, 탭, 선택 항목, 차트에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cor de destaque aparece em botões, abas, seleções e gráficos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет акцента используется на кнопках, вкладках, выделениях и графиках."
          }
