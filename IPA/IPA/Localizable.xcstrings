    "Know someone who'd like IPA?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kennst du jemanden, dem IPA gefallen würde?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Conoces a alguien a quien le gustaría IPA?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous connaissez quelqu'un qui aimerait IPA ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conosci qualcuno a cui piacerebbe IPA?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPAを気に入りそうな人はいますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA를 좋아할 만한 사람이 있나요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conhece alguém que ia gostar do IPA?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаете, кому понравится IPA?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "认识会喜欢 IPA 的人吗？"
          }
        }
      }
    },
    "Language" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
