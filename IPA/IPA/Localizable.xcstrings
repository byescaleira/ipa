    "Share the package with AirDrop. Open it there with AltStore or SideStore, or with Sideloadly on a Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile das Paket per AirDrop. Öffne es dort mit AltStore oder SideStore oder auf einem Mac mit Sideloadly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte el paquete por AirDrop. Ábrelo allí con AltStore o SideStore, o con Sideloadly en un Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez le paquet par AirDrop. Ouvrez-le là-bas avec AltStore ou SideStore, ou avec Sideloadly sur un Mac."
