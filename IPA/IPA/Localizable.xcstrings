    "Nothing about you is sold, shared or measured." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts über dich wird verkauft, weitergegeben oder gemessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada sobre ti se vende, se comparte ni se mide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien sur vous n'est vendu, partagé ni mesuré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla su di te viene venduto, condiviso o misurato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
