        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 설정과 관계없이 IPA는 이 모습을 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
