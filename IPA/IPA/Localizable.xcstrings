    "The package leaves this device and the Files app. You can download it again from Search." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket wird von diesem Gerät und aus der Dateien-App entfernt. Du kannst es unter Suchen erneut laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
