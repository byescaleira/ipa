      }
    },
    "The password and the session leave this device's Keychain. You can sign in again at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwort und Sitzung werden aus dem Schlüsselbund dieses Geräts entfernt. Du kannst dich jederzeit wieder anmelden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña y la sesión se eliminan del llavero de este dispositivo. Puedes volver a iniciar sesión cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
