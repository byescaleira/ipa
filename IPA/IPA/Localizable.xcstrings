    "Enter the six-digit code Apple sent to your devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib den sechsstelligen Code ein, den Apple an deine Geräte gesendet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce el código de seis dígitos que Apple envió a tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le code à six chiffres envoyé par Apple sur vos appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci il codice di sei cifre che Apple ha inviato ai tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleがデバイスに送信した6桁のコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple이 기기로 보낸 6자리 코드를 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o código de seis dígitos que a Apple enviou aos seus aparelhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите шестизначный код, который Apple отправила на ваши устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 Apple 发送到你设备上的六位数验证码。"
          }
        }
      }
    },
    "Every message reaches the person who writes the code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Nachricht erreicht die Person, die den Code schreibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada mensaje llega a quien escribe el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque message arrive à la personne qui écrit le code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni messaggio arriva a chi scrive il codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージはすべて、コードを書いている本人に届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 메시지는 코드를 쓰는 사람에게 바로 전달돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada mensagem chega a quem escreve o código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое сообщение попадает к тому, кто пишет код."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条消息都会直接送到写代码的人手里。"
          }
        }
      }
    },
    "Find an app in Search, sign in under Accounts and keep the packages in Downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde eine App unter Suchen, melde dich unter Accounts an und bewahre die Pakete unter Downloads auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca una app en Buscar, inicia sesión en Cuentas y guarda los paquetes en Descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez une app dans Rechercher, connectez-vous dans Comptes et gardez les paquets dans Téléchargements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova un’app in Cerca, accedi in Account e conserva i pacchetti in Download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「検索」でAppを見つけ、「アカウント」でサインインし、パッケージは「ダウンロード」に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색에서 앱을 찾고, 계정에서 로그인하고, 패키지는 다운로드에 보관하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre um app em Buscar, entre em Contas e guarde os pacotes em Downloads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите приложение в «Поиске», войдите в «Аккаунтах» и храните пакеты в «Загрузках»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“搜索”中找到 App，在“账户”中登录，安装包保存在“下载”中。"
          }
        }
      }
    },
