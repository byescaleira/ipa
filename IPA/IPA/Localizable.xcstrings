    },
    "This device can't run the store engine yet." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este aparelho ainda não roda o motor da loja."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo aún no puede ejecutar el motor de la tienda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät kann die Store-Engine noch nicht ausführen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne peut pas encore exécuter le moteur du Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non può ancora eseguire il motore dello Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスではまだストアエンジンを実行できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 아직 스토어 엔진을 실행할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备暂时无法运行商店引擎。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство пока не может запустить движок магазина."
          }
        }
      }
    },
    "The engine runs Apple's store code on this device for sign-in, versions and downloads. Search never needs it." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O motor roda o código da loja da Apple neste aparelho para login, versões e downloads. A busca nunca precisa dele."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor ejecuta el código de la tienda de Apple en este dispositivo para el inicio de sesión, las versiones y las descargas. La búsqueda nunca lo necesita."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Engine führt Apples Store-Code auf diesem Gerät für Anmeldung, Versionen und Downloads aus. Die Suche braucht sie nie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur exécute le code de l'App Store d'Apple sur cet appareil pour la connexion, les versions et les téléchargements. La recherche n'en a jamais besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il motore esegue il codice dello Store di Apple su questo dispositivo per accesso, versioni e download. La ricerca non ne ha mai bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジンはサインイン、バージョン、ダウンロードのためにこのデバイスでAppleのストアコードを動かします。検索には不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔진은 로그인, 버전, 다운로드를 위해 이 기기에서 Apple의 스토어 코드를 실행합니다. 검색에는 필요하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引擎会在此设备上运行 Apple 的商店代码，用于登录、版本和下载。搜索从不需要它。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движок запускает код магазина Apple на этом устройстве для входа, версий и загрузок. Поиску он не нужен."
          }
        }
      }
    },
    "Turn on JIT with StikDebug, then check again. Search and app details work without it." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o JIT com o StikDebug e verifique de novo. A busca e os detalhes dos apps funcionam sem ele."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el JIT con StikDebug y vuelve a comprobar. La búsqueda y los detalles de las apps funcionan sin él."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere JIT mit StikDebug und prüfe erneut. Suche und App-Details funktionieren auch ohne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le JIT avec StikDebug, puis vérifiez à nouveau. La recherche et les détails des apps fonctionnent sans lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva il JIT con StikDebug e controlla di nuovo. Ricerca e dettagli delle app funzionano anche senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StikDebugでJITをオンにしてから、もう一度確認してください。検索とアプリの詳細はJITなしでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StikDebug로 JIT를 켠 다음 다시 확인하세요. 검색과 앱 정보는 JIT 없이도 작동합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 StikDebug 开启 JIT，然后再次检查。搜索和 App 详情无需 JIT 也能使用。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите JIT через StikDebug и проверьте снова. Поиск и сведения о приложениях работают и без него."
          }
        }
      }
    },
    "Search and app details still work here. Sign in and download on a Mac, iPhone or iPad." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca e os detalhes dos apps funcionam aqui. Entre e baixe num Mac, iPhone ou iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda y los detalles de las apps funcionan aquí. Inicia sesión y descarga en un Mac, iPhone o iPad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
