    "IPA changes language right away. System texts, such as the keyboard and date pickers, follow the next time the app opens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA wechselt die Sprache sofort. Systemtexte wie Tastatur und Datumsauswahl folgen beim nächsten Öffnen der App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA cambia de idioma al instante. Los textos del sistema, como el teclado y los selectores de fecha, cambian la próxima vez que abras la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA change de langue immédiatement. Les textes du système, comme le clavier et les sélecteurs de date, suivront à la prochaine ouverture de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA cambia lingua subito. I testi di sistema, come la tastiera e i selettori di data, si aggiornano alla prossima apertura dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPAの言語はすぐに切り替わります。キーボードや日付ピッカーなどのシステムの表示は、次にAppを開いたときに切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA의 언어는 바로 바뀝니다. 키보드나 날짜 선택기 같은 시스템 텍스트는 다음에 앱을 열 때 바뀝니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O IPA muda de idioma na hora. Textos do sistema, como o teclado e os seletores de data, acompanham na próxima vez que o app abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA сразу меняет язык. Системные тексты, например клавиатура и выбор даты, изменятся при следующем запуске приложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA 会立即切换语言。键盘和日期选择器等系统文字会在下次打开 App 时切换。"
          }
        }
      }
    },
    "IPA follows the light and dark setting of your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA folgt der Hell- und Dunkel-Einstellung deines Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA sigue el ajuste claro u oscuro de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA suit le réglage clair ou sombre de ton appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA segue l’impostazione chiara o scura del tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPAはデバイスのライト/ダーク設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA는 기기의 라이트 및 다크 설정을 따릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O IPA segue o ajuste claro ou escuro do seu aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA следует светлой или тёмной теме вашего устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA 会跟随设备的浅色和深色设置。"
          }
        }
      }
    },
    "IPA grows by word of mouth, one friend at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA wächst durch Mundpropaganda, ein Freund nach dem anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA crece de boca en boca, un amigo a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA grandit par le bouche-à-oreille, un ami à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA cresce con il passaparola, un amico alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPAは口コミで、友だちひとりずつ広がっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA는 입소문으로, 친구 한 명씩 성장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O IPA cresce no boca a boca, um amigo de cada vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA растёт благодаря сарафанному радио — по одному другу за раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA 靠口口相传成长，一次一位朋友。"
          }
        }
      }
    },
    "IPA keeps this look whatever your device uses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA behält dieses Aussehen, egal was dein Gerät verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA mantiene este aspecto sin importar lo que use tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA garde cette apparence, quel que soit le réglage de ton appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA mantiene questo aspetto qualunque cosa usi il tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの設定に関係なく、IPAはこの外観のままです。"
