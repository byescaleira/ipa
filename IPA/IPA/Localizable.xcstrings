    "This can't be undone. IPA keeps nothing on a server to bring it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lässt sich nicht rückgängig machen. IPA bewahrt nichts auf einem Server auf, um es zurückzuholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede deshacer. IPA no guarda nada en un servidor para recuperarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est irréversible. IPA ne garde rien sur un serveur pour le récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si può annullare. IPA non conserva nulla su un server per recuperarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作は取り消せません。IPAは復元用のデータをサーバに保存していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "되돌릴 수 없습니다. IPA는 복원할 데이터를 서버에 보관하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não pode ser desfeito. O IPA não guarda nada num servidor para trazer de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это нельзя отменить. IPA ничего не хранит на сервере, чтобы вернуть данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销。IPA 不会在服务器上保留任何可恢复的数据。"
          }
        }
      }
    },
