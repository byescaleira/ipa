    "Sign in with an Apple ID to list versions and download free apps. The password stays in this device's Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit einer Apple ID an, um Versionen zu sehen und kostenlose Apps zu laden. Das Passwort bleibt im Schlüsselbund dieses Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con un Apple ID para ver versiones y descargar apps gratis. La contraseña se queda en el llavero de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec un identifiant Apple pour voir les versions et télécharger des apps gratuites. Le mot de passe reste dans le trousseau de cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con un Apple ID per vedere le versioni e scaricare app gratuite. La password resta nel portachiavi di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple IDでサインインすると、バージョンを表示して無料のAppをダウンロードできます。パスワードはこのデバイスのキーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ID로 로그인하면 버전을 보고 무료 앱을 다운로드할 수 있습니다. 암호는 이 기기의 키체인에 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com um Apple ID para ver versões e baixar apps grátis. A senha fica no Keychain deste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите с Apple ID, чтобы видеть версии и загружать бесплатные приложения. Пароль хранится в связке ключей этого устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple ID 登录，即可查看版本并下载免费 App。密码保存在本设备的钥匙串中。"
          }
        }
      }
    },
