    "Search and app details still work here. Sign in and download on a Mac, iPhone or iPad." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche und App-Details funktionieren hier. Anmelden und laden kannst du auf einem Mac, iPhone oder iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda y los detalles de las apps funcionan aquí. Inicia sesión y descarga en un Mac, iPhone o iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche et les détails des apps fonctionnent ici. Connectez-vous et téléchargez sur un Mac, un iPhone ou un iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca e dettagli delle app funzionano qui. Accedi e scarica su un Mac, iPhone o iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでも検索とアプリの詳細は使えます。サインインとダウンロードはMac、iPhone、iPadで行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서도 검색과 앱 정보는 작동합니다. 로그인과 다운로드는 Mac, iPhone 또는 iPad에서 하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca e os detalhes dos apps funcionam aqui. Entre e baixe num Mac, iPhone ou iPad."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск и сведения о приложениях работают и здесь. Входите и скачивайте на Mac, iPhone или iPad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里仍可使用搜索和 App 详情。请在 Mac、iPhone 或 iPad 上登录和下载。"
          }
        }
      }
    },
    "Search and app details still work. Sign-in and downloads wait, and IPA says why instead of failing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche und App-Details funktionieren weiter. Anmeldung und Downloads warten, und IPA sagt den Grund, statt zu scheitern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda y los detalles de las apps siguen funcionando. El inicio de sesión y las descargas esperan, e IPA explica por qué en lugar de fallar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche et les détails des apps fonctionnent toujours. La connexion et les téléchargements attendent, et IPA explique pourquoi au lieu d'échouer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca e dettagli delle app funzionano comunque. Accesso e download restano in attesa e IPA spiega il motivo invece di fallire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索とアプリの詳細はそのまま使えます。サインインとダウンロードは待機し、IPAは失敗する代わりに理由を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색과 앱 정보는 계속 작동합니다. 로그인과 다운로드는 대기하며, IPA는 실패하는 대신 이유를 알려 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca e os detalhes dos apps continuam funcionando. Login e downloads esperam, e o IPA diz o motivo em vez de falhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск и сведения о приложениях работают. Вход и загрузки ждут, а IPA объясняет причину вместо ошибки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索和 App 详情仍可使用。登录和下载会等待，IPA 会说明原因而不是直接失败。"
          }
        }
      }
    },
